# ───────── Armazenamento
# Banco: Postgres. Na Vercel, conecte o banco ao projeto (Storage → Create Database → Postgres/Neon): a conexão cria
# DATABASE_URL (e POSTGRES_URL) sozinha. As tabelas são criadas na primeira consulta de cada versão do sistema.
DATABASE_URL=postgres://usuario:senha@host:5432/banco
# Arquivos (XML, anexos, cópias de segurança): ficam no próprio banco. Opcional — Vercel Blob PRIVADO conectado ao
# projeto (Storage → Blob): os arquivos novos passam a ir para ele. A conexão cria a variável:
# BLOB_READ_WRITE_TOKEN=
# Opcionais: conexões por instância (padrão 5) e isolamento das transações (padrão READ COMMITTED)
# PG_POOL_MAX=5
# PG_TX_ISOLATION=READ COMMITTED
# Forçar um armazenamento: postgres | appwrite | local | memory  (sem isto: postgres se DATABASE_URL existir; senão
# appwrite se APPWRITE_* existirem; local em desenvolvimento; memory na Vercel sem banco — demonstração volátil)
# DATA_BACKEND=postgres

# ───────── Appwrite (instalações antigas — substituído pelo Postgres; ver docs/regras-assumidas.md §48)
# APPWRITE_ENDPOINT=https://<regiao>.cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID=
# APPWRITE_API_KEY=
# APPWRITE_DATABASE_ID=intercert
# APPWRITE_BUCKET_ID=documents

# ───────── Aplicação
APP_TIMEZONE=America/Sao_Paulo
# Protege /api/jobs (Vercel Cron envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Cifra os segredos da autenticação em duas etapas: qualquer texto longo e aleatório. Obrigatória em publicação com
# banco de verdade (sem ela a segunda etapa não funciona). Trocar o valor obriga a recadastrar os autenticadores.
AUTH_ENCRYPTION_KEY=
# Senha dos usuários da demonstração (seed)
DEMO_PASSWORD=Intercert@2026
# Acesso rápido na tela de login (1 = ligado). Na publicação fica LIGADO por decisão do titular até ele mandar tirar;
# ligado, protege os usuários da lista (não são inativados, não trocam senha/e-mail/login, sem bloqueio por tentativas).
SHOW_DEMO_LOGIN=0

# ───────── Integrações (as telas guardam apenas o NOME da variável; os valores ficam aqui)
FOCUSNFE_TOKEN=
NFCE_CSC=
MERCADOPAGO_ACCESS_TOKEN=
RESEND_API_KEY=
