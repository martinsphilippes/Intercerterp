# ───────── Armazenamento
# appwrite | local | memory  (padrão: appwrite se APPWRITE_* definidos; local em dev; memory na Vercel sem Appwrite)
DATA_BACKEND=appwrite
APPWRITE_ENDPOINT=https://<regiao>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=intercert
# Opcional: planos com limite de buckets (o gratuito permite 1) — todos os arquivos vão para este bucket
# APPWRITE_BUCKET_ID=documents

# ───────── Aplicação
APP_TIMEZONE=America/Sao_Paulo
# Protege /api/jobs (Vercel Cron envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Senha dos usuários da demonstração (seed)
DEMO_PASSWORD=Intercert@2026
SHOW_DEMO_LOGIN=0

# ───────── Integrações (as telas guardam apenas o NOME da variável; os valores ficam aqui)
FOCUSNFE_TOKEN=
NFCE_CSC=
MERCADOPAGO_ACCESS_TOKEN=
RESEND_API_KEY=
